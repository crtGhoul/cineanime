<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CineAnime</AssemblyName>
    <RootNamespace>CineAnime</RootNamespace>
    <ApplicationTitle>CineAnime Media Shell</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>crtGhoul</Authors>
    <Description>Open Source Client Media Shell and Anime Tracker</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\index.html" Link="wwwroot\index.html" Condition="Exists('..\index.html')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\about.html" Link="wwwroot\about.html" Condition="Exists('..\about.html')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\servers.json" Link="wwwroot\servers.json" Condition="Exists('..\servers.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\manifest.webmanifest" Link="wwwroot\manifest.webmanifest" Condition="Exists('..\manifest.webmanifest')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\icon.svg" Link="wwwroot\icon.svg" Condition="Exists('..\icon.svg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\icon-192.png" Link="wwwroot\icon-192.png" Condition="Exists('..\icon-192.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\icon-512.png" Link="wwwroot\icon-512.png" Condition="Exists('..\icon-512.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\vendor\hls.min.js" Link="wwwroot\vendor\hls.min.js" Condition="Exists('..\vendor\hls.min.js')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
